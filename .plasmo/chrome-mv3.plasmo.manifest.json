{
  "icons": {
    "16": "./gen-assets/icon16.plasmo.png",
    "32": "./gen-assets/icon32.plasmo.png",
    "48": "./gen-assets/icon48.plasmo.png",
    "64": "./gen-assets/icon64.plasmo.png",
    "128": "./gen-assets/icon128.plasmo.png"
  },
  "manifest_version": 3,
  "action": {
    "default_icon": {
      "16": "./gen-assets/icon16.plasmo.png",
      "32": "./gen-assets/icon32.plasmo.png",
      "48": "./gen-assets/icon48.plasmo.png",
      "64": "./gen-assets/icon64.plasmo.png",
      "128": "./gen-assets/icon128.plasmo.png"
    }
  },
  "version": "1.0.0",
  "author": "",
  "name": "DEV | ",
  "description": "",
  "background": {
    "service_worker": "./static/background/index.ts"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*/following*",
        "https://twitter.com/*/following*"
      ],
      "js": [
        "..\\src\\contents\\following-active.ts"
      ]
    },
    {
      "matches": [
        "https://x.com/*/following*",
        "https://twitter.com/*/following*"
      ],
      "js": [
        "..\\src\\contents\\following-passive.ts"
      ]
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "..\\src\\contents\\index.ts"
      ]
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "static\\contents\\ui-overlay.tsx"
      ]
    }
  ]
}
